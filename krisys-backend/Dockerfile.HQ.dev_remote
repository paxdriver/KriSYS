# krisys-backend/Dockerfile.HQ.dev_remote
# “DEV / EPHEMERAL ONLY — DO NOT USE IN PRODUCTION”
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
	libsqlite3-0 \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Explicit dev-remote environment
ENV FLASK_ENV=dev_remote
ENV KRISYS_HQ_STATE_DIR=/app/blockchain
ENV BLOCKCHAIN_DB_PATH=/app/blockchain/blockchain.db
ENV PYTHONUNBUFFERED=1

# You will expose a non-standard port for remote testing
ENV PORT=5123

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . /app

# Bind explicitly to the dev-remote port
EXPOSE 5123

CMD ["gunicorn", "-b", "0.0.0.0:5123", "app:app", "--workers", "1"]


# USAGE on Linode
#################
# [KriSys]/DEV_REMOTE_TEST$
# docker build --no-cache -f ../krisys-backend/Dockerfile.HQ.dev_remote -t krisys-hq ../krisys-backend/
# docker save krisys-hq > krisys-hq.tar
# rsync -avP -e "ssh -o IdentitiesOnly=yes" ./krisys-hq.tar [username]@[cloud ip address]:~/dev_krisys/krisys-hq.tar
#
# [on linode]
# cd dev_krisys
# mkdir ~/dev_krisys/data
# sudo docker load < krisys-hq.tar
# sudo docker run -d -p 5123:5123 -v ~/dev_krisys/data:/app/blockchain --name krisys-hq krisys-hq
