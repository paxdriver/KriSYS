# krisys-backend/relay-offline-server/Dockerfile.Relay.dev_remote
# “DEV / EPHEMERAL ONLY — DO NOT USE IN PRODUCTION”
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
libsqlite3-0 \
&& rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Explicit dev-remote environment
ENV FLASK_ENV=dev_remote
ENV PYTHONUNBUFFERED=1

# Central server URL (Linode)
ENV CENTRAL_API_URL=http://krisys.krisdriver.com:5123

# Relay data directory
ENV RELAY_DATA_DIR=/app/data

# Relay will pull data from central when online, 0 means it only gets blocks from peers
ENV RELAY_AUTO_PULL=1
# Relay will pull data from central when online, 0 means it only gets blocks from peers
ENV RELAY_AUTO_PULL=1
# Optional: Setting CENTRAL_API_URL enables:
# 1) Central auto-provisioning (if UNINITIALIZED)
# 2) Central block pull (if RELAY_AUTO_PULL=1)
# Omit for station-only provisioning.
# ENV CENTRAL_API_URL=http://localhost:5000

# Reuse top-level requirements
COPY ./requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy only the relay app
COPY ./relay-offline-server/ /app
# Copy the shared utility function for relay's local blockchain validation/reconciliation
COPY canonical_block.py /app/
COPY reconcile_local_chain.py /app/

EXPOSE 5000

CMD ["gunicorn", "-b", "0.0.0.0:5000", "app:app", "--workers", "1"]


# Dockerfile for development setting testing on separate physical machines (ie: NOT using docker-compose)
# docker build \
# 	-f krisys-backend/relay-offline-server/Dockerfile.Relay.dev_remote \
# 	-t krisys-relay-dev-remote \
# 	.

# docker run -d \
# 	-p 6002:5000 \
# 	-v $(pwd)/relay-data:/app/data \
# 	--name krisys-relay \
# 	krisys-relay-dev-remote